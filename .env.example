# Restricted KEY=value format. Do not add secrets to this file.
APP_NAME=my-app
DEPLOY_USER=deploy
APP_ROOT=/opt/apps
SSH_PORT=22
ENABLE_SYSTEM_UPGRADE=false
ENABLE_SWAP=true
SWAP_SIZE_GB=2
ENABLE_UFW=true
ENABLE_FAIL2BAN=true
ENABLE_UNATTENDED_UPGRADES=true
ENABLE_SSH_HARDENING=false
GIT_REPOSITORY=
GIT_BRANCH=main
HEALTHCHECK_URL=http://127.0.0.1/health
HEALTHCHECK_ATTEMPTS=30
HEALTHCHECK_INTERVAL_SECONDS=2
